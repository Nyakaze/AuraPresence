{
  "manifest_version": 3,
  "name": "Aura",
  "version": "1.0.0",
  "description": "Lets Aura see what plays on the sites its plugins support. Shows on its icon whether Aura is connected.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Aura isn't connected" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
