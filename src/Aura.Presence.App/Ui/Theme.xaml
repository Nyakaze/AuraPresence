        <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10" />
        <EllipseGeometry Center="12,12" RadiusX="4.5" RadiusY="4.5" />
    </GeometryGroup>
    <GeometryGroup x:Key="G.Grip">
        <EllipseGeometry Center="9,5" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="9,12" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="9,19" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="15,5" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="15,12" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="15,19" RadiusX="1" RadiusY="1" />
    </GeometryGroup>
