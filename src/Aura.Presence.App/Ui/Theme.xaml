<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Aura.Presence.App.Ui">

    <SolidColorBrush x:Key="Bg" Color="#0C0C0E" />
    <SolidColorBrush x:Key="Surface" Color="#141417" />
    <SolidColorBrush x:Key="Raise" Color="#1D1D21" />
    <SolidColorBrush x:Key="Ink" Color="#ECECEF" />
    <SolidColorBrush x:Key="Text" Color="#D6ECECEF" />
    <SolidColorBrush x:Key="Muted" Color="#8E8E96" />
    <SolidColorBrush x:Key="Action" Color="#9D7CF4" />
    <SolidColorBrush x:Key="ActionInk" Color="#0C0C0E" />
    <SolidColorBrush x:Key="Warn" Color="#F2B45A" />
    <SolidColorBrush x:Key="Fail" Color="#FF7A6B" />
    <SolidColorBrush x:Key="TileBg" Color="#222227" />
    <SolidColorBrush x:Key="TileInk" Color="#B9A2FF" />
    <SolidColorBrush x:Key="SegOn" Color="#2C2C32" />
    <SolidColorBrush x:Key="Line" Color="#1CECECEF" />
    <SolidColorBrush x:Key="LineStrong" Color="#33ECECEF" />
    <SolidColorBrush x:Key="Hover" Color="#0AECECEF" />
    <SolidColorBrush x:Key="Overlay" Color="#17ECECEF" />
    <SolidColorBrush x:Key="Secondary" Color="#252528" />
    <SolidColorBrush x:Key="SwitchOff" Color="#2EECECEF" />
    <SolidColorBrush x:Key="Thumb" Color="#3A3A41" />
    <SolidColorBrush x:Key="ThumbHover" Color="#55555E" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="ClosePressed" Color="#A8261A" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <ui:ShownConverter x:Key="Shown" />
    <ui:CapsuleConverter x:Key="Capsule" />

